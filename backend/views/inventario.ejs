<%- include('partials/header', { title: 'Inventario' }) %>
<main class="main-content">
  <div class="page-toolbar">
    <h2>Inventario</h2>
  </div>
  <div class="product-grid">
    <% productos.forEach(p => { %>
      <div class="product-card">
        <div class="card-info">
          <h3 class="card-title"><%= p.nombre %></h3>
          <p class="card-desc"><%= p.descripcion %></p>
          <p class="card-price">Q<%= parseFloat(p.precio).toFixed(2) %></p>
          <p class="card-stock <%= p.stock < 5 ? 'stock-low' : '' %>">Stock: <%= p.stock %></p>
          <% if (p.total_vendido) { %>
            <p class="card-desc">Vendidos: <%= p.total_vendido %></p>
          <% } %>
        </div>
        <div class="card-img">
          <img src="<%= p.imagen_url %>" alt="<%= p.nombre %>" onerror="this.src='/img/default.png'">
        </div>
      </div>
    <% }) %>
  </div>
  <button class="btn-fab" onclick="document.getElementById('modal-agregar').classList.add('open')">+</button>
  <div id="modal-agregar" class="modal-overlay">
    <div class="modal-card">
      <h3>Agregar producto</h3>
      <form method="POST" action="/inventario/agregar">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" name="nombre" required>
        </div>
        <div class="form-group">
          <label>Descripción</label>
          <input type="text" name="descripcion">
        </div>
        <div class="form-group">
          <label>Precio (Q)</label>
          <input type="number" name="precio" step="0.01" min="0" required>
        </div>
        <div class="form-group">
          <label>Stock</label>
          <input type="number" name="stock" min="0" required>
        </div>
        <div class="form-group">
          <label>Categoría</label>
          <select name="id_categoria" required>
            <% categorias.forEach(c => { %>
              <option value="<%= c.id_categoria %>"><%= c.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>URL de imagen (opcional)</label>
          <input type="text" name="imagen_url" placeholder="https://...">
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary"
            onclick="document.getElementById('modal-agregar').classList.remove('open')">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</main>
<%- include('partials/footer') %>