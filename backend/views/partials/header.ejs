<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <span class="nav-page"><%- title %></span>
    <% if (usuario) { %>
      <div class="nav-links">

        <% if (usuario.rol === 'cliente') { %>
          <a href="/" class="nav-link">Tienda</a>
          <a href="/carrito" class="nav-link">Carrito</a>
          <a href="/historial" class="nav-link">Mis compras</a>
        <% } %>

        <% if (usuario.rol === 'empleado') { %>
          <a href="/inventario" class="nav-link">Inventario</a>
          <a href="/historial" class="nav-link">Historial</a>
        <% } %>

        <% if (usuario.rol === 'admin') { %>
          <a href="/" class="nav-link">Tienda</a>
          <a href="/inventario" class="nav-link">Inventario</a>
          <a href="/empleados" class="nav-link">Empleados</a>
          <a href="/historial" class="nav-link">Historial</a>
        <% } %>

        <% if (usuario.rol === 'gerente') { %>
          <a href="/empleados" class="nav-link">Empleados</a>
          <a href="/historial" class="nav-link">Historial</a>
        <% } %>

        <% if (usuario.rol === 'proveedor') { %>
          <a href="/proveedores" class="nav-link">Mis productos</a>
        <% } %>

        <span class="nav-user"><%= usuario.username %> (<%= usuario.rol %>)</span>
        <a href="/logout" class="btn-logout" title="Cerrar sesión">&#x2192;</a>
      </div>
    <% } %>
  </nav>
  <header class="site-header">
    <a href="/" class="site-title">ecommerce.com</a>
  </header>